{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entregas-ljcs-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "entregas-ljcs-demo",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [{ "name": "DISPATCH", "class_name": "DispatchCity" }]
  },
  "migrations": [{ "tag": "central-v1", "new_sqlite_classes": ["DispatchCity"] }]
}
